{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "moduleResolution": "node16",
    "module": "node16",
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "fleet-dashboard/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/__tests__/**", "fleet-dashboard/tests/**"]
}
